<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Which SDK to build against, most specific first:

      1. SharpProsperoRoot passed on the command line.
      2. The SDK beside this project, which is where it lives in this checkout.
      3. The SHARPPROSPERO_ROOT environment variable.

    The sibling beats the environment variable deliberately. A machine with that variable set to some
    other checkout would otherwise build this against an SDK it was never written for, and nothing
    would say so - the reference simply points somewhere else and the errors, if any, read as ordinary
    compile failures.
  -->
  <PropertyGroup>
    <SharpProsperoRoot Condition="'$(SharpProsperoRoot)' == '' And Exists('$(MSBuildThisFileDirectory)..\SharpProspero\build\Prospero.App.props')">$(MSBuildThisFileDirectory)..\SharpProspero</SharpProsperoRoot>
    <SharpProsperoRoot Condition="'$(SharpProsperoRoot)' == ''">$(SHARPPROSPERO_ROOT)</SharpProsperoRoot>
  </PropertyGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.App.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProsperoExplorer</RootNamespace>
    <AssemblyName>ProsperoExplorer</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <ProsperoModuleName>eboot.bin</ProsperoModuleName>
    <!-- The viewers hold a decoded picture, an archive and a text buffer at once, so the ceiling is
         above the template's. -->
    <ProsperoHeapHardLimitBytes>402653184</ProsperoHeapHardLimitBytes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SharpProsperoRoot)\src\SharpProspero\SharpProspero.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sce_sys\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.App.targets" />

</Project>
